# Database
DATABASE_URL="postgresql://aimnote:aimnote_dev_2026@localhost:5432/aim_meeting_note?schema=public"

# JWT
JWT_SECRET="hackathon-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="24h"

# LLM (OpenAI-compatible: Ollama, LM Studio, or OpenAI cloud)
# For Ollama: http://localhost:11434/v1 with any API key
# For LM Studio: http://localhost:1234/v1 with any API key
# For OpenAI: https://api.openai.com/v1 with your real key
OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_API_KEY="ollama"
OPENAI_MODEL="llama3.2"

# Set to "mock" to force the deterministic Mock LLM (no Ollama/OpenAI needed).
# Leave unset to auto-detect: tries Ollama, falls back to Mock if unreachable.
# LLM_PROVIDER="mock"

# App
NEXT_PUBLIC_APP_NAME="Chitragupta"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
